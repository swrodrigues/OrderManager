# Copy to .env and replace every value. .env is git-ignored.

# Database password (used by both containers)
POSTGRES_PASSWORD=change-me-db-password

# AES-256 key for field encryption: Base64 of exactly 32 random bytes.
# Generate with:  openssl rand -base64 32
APP_ENC_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32

# First admin account, created on first start only (password: at least 12 characters)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

# "demo" seeds 50 SKUs and 1,000 orders on an empty database; leave empty for a clean start
SPRING_PROFILES_ACTIVE=demo

# Set to true when served over HTTPS behind a reverse proxy
APP_COOKIE_SECURE=false

# Time zone used to display timestamps
APP_TIME_ZONE=Europe/Amsterdam
